# Server
PORT=3004
NODE_ENV=development

# Database (own DB for rental-service)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=1234
DB_DATABASE=rental_service_db

# Car Service (for car availability, pricing, status)
CAR_SERVICE_URL=http://localhost:3003

# User Service (for renter validation)
USER_SERVICE_URL=http://localhost:3002

# Service-to-service auth (optional)
SERVICE_API_KEY=internal-service-key

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=rental-service
