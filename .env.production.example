NODE_ENV=production

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=user_service_db

# CORS / public URLs
CORS_ORIGIN=https://your-domain.example
PUBLIC_BASE_URL=https://your-domain.example
VITE_API_URL=/api
HTTP_PORT=80

# Internal service auth
SERVICE_API_KEY=replace_with_random_long_internal_key

# JWT secrets
JWT_SECRET=replace_with_random_long_gateway_secret
USER_SERVICE_JWT_SECRET=replace_with_random_long_user_service_secret
# Optional explicit override:
# JWT_VERIFY_SECRETS=replace_if_you_need_custom_list

# Gateway auth mode
ENABLE_DEV_AUTH=false
ALLOW_INSECURE_JWT_DECODE=false

# Optional AI config
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
